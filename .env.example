# Copy to .env. Installers generate all three tokens (each >=32 hex chars, all different). Never commit .env.
# BROKER_TOKEN = operator (dashboard kill/revive at supervisor). GATEWAY_TOKEN = dashboard->gateway.
# AUDIT_TOKEN = gateway->supervisor audit-only. A compromised gateway cannot kill or revive.
BROKER_TOKEN=
GATEWAY_TOKEN=
AUDIT_TOKEN=
META_API_KEY=
META_MODEL=muse-spark-1.1
META_API_BASE=https://api.meta.ai/v1
ORGANISM_MODE=suggest
# Optional signed identity: ingress sends X-User-Id-Sig=HMAC-SHA256(key, user-id).
IDENTITY_HMAC_KEY=
